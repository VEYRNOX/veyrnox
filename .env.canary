# Canary environment configuration.
# Used by the canary-release workflow to publish a production-adjacent artifact
# to the dedicated Cloudflare Pages `canary` branch.
#
# No secrets here — GitHub Actions injects public repo variables as needed.

VITE_ENV_LABEL=Canary
VITE_ENV=canary

# Canary must not write to production Supabase. Keep the staging-style blanking
# so the built artifact can be exercised without touching live data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Buy remains enabled here so the canary lane exercises the same pre-prod entry
# surface as staging, still against Transak's sandbox environment.
VITE_BUY_ENABLED=true
VITE_TRANSAK_ENVIRONMENT=STAGING

# RevenueCat public SDK keys remain safe to ship in this client bundle.
VITE_REVENUECAT_APPLE_API_KEY=appl_hZAPucuVlTtJFQYLKefTLuKdSMH
VITE_REVENUECAT_GOOGLE_API_KEY=goog_NLWbRiiHvzzZthIzuwygAgVjdSQ
