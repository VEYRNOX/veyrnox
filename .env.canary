# Canary environment configuration.
# Used by the canary-release workflow to publish a production-adjacent artifact
# to the dedicated Cloudflare Pages `canary` branch.
#
# No secrets here — GitHub Actions injects public repo variables as needed.

VITE_ENV_LABEL=Canary
VITE_ENV=canary

# Client-side only: blanking these VITE_* values keeps the shipped bundle from
# reaching Supabase directly. Pages Functions are unaffected and still use the
# runtime bindings configured for the project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Buy remains enabled here so the canary lane exercises the same pre-prod entry
# surface as staging, still against Transak's sandbox environment.
VITE_BUY_ENABLED=true
VITE_TRANSAK_ENVIRONMENT=STAGING

# RevenueCat public SDK keys remain safe to ship in this client bundle.
VITE_REVENUECAT_APPLE_API_KEY=appl_hZAPucuVlTtJFQYLKefTLuKdSMH
VITE_REVENUECAT_GOOGLE_API_KEY=goog_NLWbRiiHvzzZthIzuwygAgVjdSQ

# AI Security Protection RevenueCat offering id. Without this,
# getAiSecurityProtectionOfferingId() in src/lib/purchases.js returns null,
# and the paywall card renders "RevenueCat offering is not configured in
# this build yet" instead of the store paywall. The offering lookup key
# lives in RC (`ai-security-protection`) and its products are attached on
# both stores; this env just lets the client fetch them.
VITE_RC_AI_SECURITY_PROTECTION_OFFERING_ID=ai-security-protection
