<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Defaults false. CI substitutes true only for the Firebase Test Lab
             build variant (F-1, 2026-08-15 — staging store packages no longer
             enable Firebase at all). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${firebaseObservabilityCollectionEnabled}" />
        <meta-data
            android:name="firebase_performance_collection_enabled"
            android:value="${firebaseObservabilityCollectionEnabled}" />
        <!-- F-1 Gap 3: the HARD kill switch. Unlike ..._enabled above, this
             cannot be undone by setPerformanceCollectionEnabled(true) at
             runtime. True everywhere except the Test Lab variant. -->
        <meta-data
            android:name="firebase_performance_collection_deactivated"
            android:value="${firebasePerformanceDeactivated}" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme: veyrnox://wc?uri=<wc-uri> — a dApp/WalletConnect can
                 launch Veyrnox with no domain verification (works on an installed app).
                 singleTask (above) keeps it a single instance so appUrlOpen fires into
                 the running app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="veyrnox" />
            </intent-filter>

            <!-- Verified App Links: https://veyrnox.com/wc?uri=... — autoVerify checks
                 https://veyrnox.com/.well-known/assetlinks.json (see public/.well-known/).
                 Only opens Veyrnox directly once verification passes AND the app is
                 installed; falls back to the browser otherwise. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="veyrnox.com" android:pathPrefix="/wc" />
            </intent-filter>

            <!-- Transak on-ramp return: https://veyrnox.com/buy/return?tid=... — same
                 autoVerify path as /wc above, reads the SAME assetlinks.json. Routes
                 to /buy/in-progress via src/components/DeepLinkHandler.jsx. The
                 return-URL payload is NOT trusted as proof of purchase; funds are
                 confirmed by on-chain balance polling of the deposit address. See
                 docs/transak-integration-spec.md §7 for the full return handling. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="veyrnox.com" android:pathPrefix="/buy/return" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Bug-report screen recording (slice 2b of docs/bug-report-recording-plan.md).
             MediaProjection on Android 14+ (API 34+) REQUIRES a running foreground
             service of type mediaProjection at the moment getMediaProjection() is
             called, or the framework throws SecurityException. This service exists
             only to satisfy that requirement — the plugin owns the MediaRecorder +
             VirtualDisplay lifecycle. Zero runtime effect on shipped builds because
             the calling JS is gated behind VITE_BUG_REPORT_ENABLED (default OFF). -->
        <service
            android:name=".BugReportRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for the QR-code scanner in the Send flow and for WalletConnect
         pairing (src/components/QRScanner.jsx uses navigator.mediaDevices.getUserMedia
         via Capacitor's WebView; the WebView's onPermissionRequest requires this
         manifest declaration or the runtime prompt silently fails and QR scanning
         breaks). Camera is used to scan; frames are decoded on-device by jsQR and
         never leave the device. Declared as an optional hardware feature so tablets
         or emulators without a camera can still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Required for the Voice Commands feature (src/context/VoiceContext.jsx via
         @capacitor-community/speech-recognition). Read-only navigation only —
         never initiates or signs a transaction by voice. Transcription happens
         off-device on the platform speech service (Google Speech Service on
         Android). Suppressed entirely in decoy/hidden sessions (I3, fail closed). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required for BiometricPrompt (fingerprint / face unlock + 2FA at Send).
         USE_BIOMETRIC covers API 28+; USE_FINGERPRINT covers API 23–27. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Bug-report screen recording (slice 2b).
         FOREGROUND_SERVICE: legal from Android 9; needed to run the recorder service.
         FOREGROUND_SERVICE_MEDIA_PROJECTION: required from Android 14 (API 34) to
           declare mediaProjection as the service's type.
         Zero-effect on shipped builds — the calling JS is gated behind
         VITE_BUG_REPORT_ENABLED (default OFF). Slice 3 store-disclosure amend
         answers the Play sensitive-permissions form for these. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
</manifest>
