# Copy to android/.env.fastlane and source before running fastlane.
# Real values: never commit.
#
# Option A — path to the Play service-account JSON key file:
# GOOGLE_PLAY_JSON_KEY_PATH=/absolute/path/to/veyrnox-play-service-account.json
#
# Option B — raw JSON string (matches ci.yml's GOOGLE_PLAY_SERVICE_ACCOUNT_JSON):
# GOOGLE_PLAY_JSON_KEY_DATA={"type":"service_account", ...}
#
# Huawei AppGallery Connect API credentials — AGC → Users and permissions →
# API key → Connect API. app_id is the numeric AGC app id (NOT the package name).
# HUAWEI_CLIENT_ID=
# HUAWEI_CLIENT_SECRET=
# HUAWEI_APP_ID=
