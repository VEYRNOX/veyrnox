# Vite auto-loads this file when `npm run build` runs (mode=production).
# NAMES ONLY: every var here is client-exposed at build time and is NOT a
# secret — secrets stay in .env.local (git-ignored) or CI secret stores.
# Add a var here only when the value must ship on every prod build.

# Personal Backup — expose the "Advanced (2-of-3)" tab.
# See docs/cloud-recovery-shard-spec.md + CLAUDE.md 2026-08-08 owner override.
# UI is pre-audit ("Advanced" tab labelled + Pre-audit preview card visible);
# vault backup stays the default. Nothing is "verified" until an on-device
# recovery trip completes and an independent audit passes.
VITE_ENABLE_PERSONAL_BACKUP_SHARDS=1

# RevenueCat public SDK keys — safe to ship in the client bundle. Without
# these baked in at build time, configurePurchases() throws
# REVENUECAT_API_KEY_MISSING, RC never initialises, no customer ever appears
# on the RC dashboard, and every install silently reads tier='free' — a total
# entitlement blackout that the app has no visible signal for. These live in
# .env.canary and .env.staging already; production was the one mode missing
# them, so a plain `npm run build` shipped without RC. Same keys across modes.
VITE_REVENUECAT_APPLE_API_KEY=appl_hZAPucuVlTtJFQYLKefTLuKdSMH
VITE_REVENUECAT_GOOGLE_API_KEY=goog_NLWbRiiHvzzZthIzuwygAgVjdSQ
