# Staging environment configuration.
# Used by `npm run build:staging` and the Deploy Preview CI workflow.
# No secrets here — those are in GitHub Actions secrets.

VITE_ENV_LABEL=Staging
VITE_ENV=staging

# Staging does NOT connect to production Supabase.
# Analytics and referral tracking are disabled in staging.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Transak on-ramp (Buy flow) — STAGING ONLY ─────────────────────────────────
# Buy is ship-gated behind VITE_BUY_ENABLED. Production builds default to
# `false` (via .env.example) so the Buy tiles are dead-code-eliminated from
# prod bundles. Staging flips it on so we can demo the flow against Transak's
# sandbox widget (global-stg.transak.com) — no real cards charged.
#
# The API key itself is NOT in this file (in case a staging key ever needs
# rotation without a code deploy). It comes from the Deploy Preview workflow
# via a GitHub Actions repository variable: `vars.VITE_TRANSAK_API_KEY`.
# Set it via: Settings → Secrets and variables → Actions → Variables → New.
VITE_BUY_ENABLED=true
VITE_TRANSAK_ENVIRONMENT=STAGING

# RevenueCat (public API keys — safe to ship in client bundle)
VITE_REVENUECAT_APPLE_API_KEY=appl_hZAPucuVlTtJFQYLKefTLuKdSMH
VITE_REVENUECAT_GOOGLE_API_KEY=goog_NLWbRiiHvzzZthIzuwygAgVjdSQ
