# Staging environment configuration.
# Used by `npm run build:staging` and the Deploy Preview CI workflow.
# No secrets here — those are in GitHub Actions secrets.

VITE_ENV_LABEL=Staging
VITE_ENV=staging

# MoonPay on-ramp — enabled in staging, disabled everywhere else.
# The API key is injected from GitHub Actions repository variable at build time;
# it must NOT be committed here. See .github/workflows/deploy-preview.yml.
VITE_BUY_ENABLED=true
